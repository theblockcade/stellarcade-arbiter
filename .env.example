# Required — no default. A misconfigured network here means the arbiter
# derives outcomes and authorizes payouts against the wrong ledger.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional — derived from STELLAR_NETWORK if omitted; set explicitly if you
# override STELLAR_NETWORK_PASSPHRASE or run against a non-standard host.
HORIZON_URL=https://horizon-testnet.stellar.org

# Required outside development/test — the arbiter refuses to boot without
# it rather than silently falling back to in-memory storage.
DATABASE_URL=postgres://arbiter:arbiter@localhost:5433/arbiter

PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# Stroops (7dp). Defaults shown.
MAX_AUTO_SETTLE_STAKE=10000000000
MAX_PAYOUT=50000000000

# Required in production — the arbiter refuses to boot in production without
# this rather than leaving /games/:gameId/commit and /rounds/:roundId/settle
# unauthenticated (security-audit.md H1). Comma-separated; any key in the
# list is accepted on the x-api-key header. /verify, /proofs/:id,
# /audit/verify, and /health stay public regardless — read-only by design.
ARBITER_API_KEYS=

# Per-IP ceiling on the same two endpoints (security-audit.md M1). Defaults
# shown.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
