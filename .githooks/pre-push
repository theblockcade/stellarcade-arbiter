#!/bin/sh

# Prevent direct pushes to main branch
protected_branch='main'
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

if [ "$protected_branch" = "$current_branch" ]; then
  echo "Direct pushes to '$protected_branch' branch are not allowed!"
  echo "Please create a feature branch and use a Pull Request instead."
  echo ""
  echo "   Example:"
  echo "   git checkout -b feature/your-feature-name"
  echo "   git push origin feature/your-feature-name"
  echo ""
  exit 1
fi

echo "Running typecheck before push..."
npm run typecheck

if [ $? -ne 0 ]; then
  echo "Typecheck failed! Push aborted."
  exit 1
fi

echo "Running lint before push..."
npm run lint

if [ $? -ne 0 ]; then
  echo "Lint failed! Push aborted."
  exit 1
fi

echo "Running dependency audit before push..."
npm audit --audit-level=high

if [ $? -ne 0 ]; then
  echo "Dependency audit failed! Push aborted."
  exit 1
fi

echo "Running tests before push..."

# store-postgres.test.ts silently skips when DATABASE_URL is unset, which let
# a real bug (broken audit hash-chain verification) reach CI undetected.
# Bring up the same Postgres this repo's CI uses (docker-compose.yml) and run
# the suite the same way CI does, so a green local push means what CI means.
DB_STARTED_BY_HOOK=0
COMPOSE_DB_URL="postgres://arbiter:arbiter@localhost:5433/arbiter"

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  if ! docker compose ps postgres 2>/dev/null | grep -q "Up"; then
    echo "Starting local Postgres (docker compose) for integration tests..."
    docker compose up -d postgres

    if [ $? -ne 0 ]; then
      echo "Failed to start Postgres via docker compose! Push aborted."
      exit 1
    fi
    DB_STARTED_BY_HOOK=1
  fi

  echo "Waiting for Postgres to be healthy..."
  for i in $(seq 1 20); do
    if docker compose exec -T postgres pg_isready -U arbiter >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  DATABASE_URL="$COMPOSE_DB_URL" CI_REQUIRE_DB=1 npm test
  TEST_EXIT=$?

  if [ "$DB_STARTED_BY_HOOK" = "1" ]; then
    docker compose stop postgres >/dev/null 2>&1
  fi
else
  echo "WARNING: Docker not available/running — Postgres integration tests"
  echo "         (store-postgres.test.ts) will be SKIPPED locally, even"
  echo "         though CI runs them for real. Start Docker to catch these"
  echo "         bugs before pushing."
  npm test
  TEST_EXIT=$?
fi

if [ $TEST_EXIT -ne 0 ]; then
  echo "Tests failed! Push aborted."
  exit 1
fi

echo "Running build before push..."
npm run build

if [ $? -ne 0 ]; then
  echo "Build failed! Push aborted."
  exit 1
fi

echo "All checks passed. Proceeding with push..."
